<Window x:Class="StatsMonitor.Views.GadgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" FontFamily="Consolas"
        ToolTip="Arraste para mover · duplo clique para abrir">
    <Border Background="{DynamicResource GadgetBg}" CornerRadius="10" Padding="12,8"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <StackPanel>
            <TextBlock FontSize="13">
                <Run Text="CPU: "/><Run Text="{Binding Cpu.LoadText, Mode=OneWay}"/>
                <Run Text="{Binding Cpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Cpu.TempBrush, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontSize="13">
                <Run Text="RAM: "/><Run Text="{Binding Ram.LoadText, Mode=OneWay}"/>
                <Run Text=" | "/><Run Text="{Binding Ram.UsedText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontSize="13">
                <Run Text="GPU: "/><Run Text="{Binding Gpu.LoadText, Mode=OneWay}"/>
                <Run Text="{Binding Gpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Gpu.TempBrush, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontSize="13">
                <Run Text="VRAM: "/><Run Text="{Binding Vram.LoadText, Mode=OneWay}"/>
                <Run Text=" | "/><Run Text="{Binding Vram.UsedText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
