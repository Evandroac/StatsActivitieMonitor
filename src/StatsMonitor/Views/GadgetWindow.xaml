<Window x:Class="StatsMonitor.Views.GadgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" FontFamily="Consolas"
        ToolTip="Duplo clique para abrir">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GadgetText}"/>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" Background="{DynamicResource GadgetBg}" CornerRadius="10" Padding="12,8"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Grid>
            <StackPanel x:Name="FloatingPanel">
                <TextBlock x:Name="FCpu" FontSize="13">
                    <Run Text="CPU: "/><Run Text="{Binding Cpu.LoadText, Mode=OneWay}"/><Run Text="{Binding Cpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Cpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FRam" FontSize="13">
                    <Run Text="RAM: "/><Run Text="{Binding Ram.LoadText, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Ram.UsedText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FGpu" FontSize="13">
                    <Run Text="GPU: "/><Run Text="{Binding Gpu.LoadText, Mode=OneWay}"/><Run Text="{Binding Gpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Gpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FVram" FontSize="13">
                    <Run Text="VRAM: "/><Run Text="{Binding Vram.LoadText, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Vram.UsedText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FNet" FontSize="13">
                    <Run Text="NET: ↓ "/><Run Text="{Binding Network.Download, Mode=OneWay}"/><Run Text=" ↑ "/><Run Text="{Binding Network.Upload, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="TaskbarPanel" Orientation="Horizontal" Margin="-12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TCpu" FontSize="12" Margin="12,0,0,0">
                    <Run Text="CPU "/><Run Text="{Binding Cpu.LoadText, Mode=OneWay}"/><Run Text="{Binding Cpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Cpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TRam" FontSize="12" Margin="12,0,0,0">
                    <Run Text="RAM "/><Run Text="{Binding Ram.LoadText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TGpu" FontSize="12" Margin="12,0,0,0">
                    <Run Text="GPU "/><Run Text="{Binding Gpu.LoadText, Mode=OneWay}"/><Run Text="{Binding Gpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Gpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TVram" FontSize="12" Margin="12,0,0,0">
                    <Run Text="VRAM "/><Run Text="{Binding Vram.LoadText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TNet" FontSize="12" Margin="12,0,0,0">
                    <Run Text="NET ↓ "/><Run Text="{Binding Network.Download, Mode=OneWay}"/><Run Text=" ↑ "/><Run Text="{Binding Network.Upload, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
