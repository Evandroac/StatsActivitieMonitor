<Window xmlns:h="clr-namespace:StatsMonitor.Helpers" xmlns:c="clr-namespace:StatsMonitor.Controls" x:Class="StatsMonitor.Views.GadgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" FontFamily="Consolas"
        ToolTip="{h:Tr 'Duplo clique para abrir'}">
    <Window.Resources>
        <Style x:Key="GadgetToolButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="5" Background="{DynamicResource GadgetBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe UI Emoji,Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GadgetText}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="10" Padding="12,8"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GadgetBg}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GadgetHoverBg}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="Body" Grid.Row="1">
            <StackPanel x:Name="FloatingPanel" HorizontalAlignment="Center">
                <TextBlock x:Name="FCpu" FontSize="13">
                    <Run Text="{h:Tr 'CPU: '}"/><Run Text="{Binding Cpu.LoadText, Mode=OneWay}" Foreground="{Binding Cpu.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Cpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Cpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FRam" FontSize="13">
                    <Run Text="{h:Tr 'RAM: '}"/><Run Text="{Binding Ram.LoadText, Mode=OneWay}" Foreground="{Binding Ram.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" | "/><Run Text="{Binding Ram.UsedText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FGpu" FontSize="13">
                    <Run Text="{h:Tr 'GPU: '}"/><Run Text="{Binding Gpu.LoadText, Mode=OneWay}" Foreground="{Binding Gpu.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Gpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Gpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="FVram" FontSize="13">
                    <Run Text="{h:Tr 'Disco: '}"/><Run Text="{Binding Disk.LoadText, Mode=OneWay}" Foreground="{Binding Disk.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock x:Name="FFps" FontSize="13">
                    <Run Text="{h:Tr 'FPS: '}"/><Run Text="{Binding FpsText, Mode=OneWay}" Foreground="{Binding FpsBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{h:Tr '  Média: '}"/><Run Text="{Binding FpsAvgText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock x:Name="FNet" FontSize="13">
                    <Run Text="{h:Tr 'NET: ↓ '}"/><Run Text="{Binding Network.Download, Mode=OneWay}"/><Run Text=" ↑ "/><Run Text="{Binding Network.Upload, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                <StackPanel x:Name="DCpu" Width="176">
                    <TextBlock FontSize="13"><Run Text="{h:Tr 'CPU: '}"/><Run Text="{Binding Cpu.LoadText, Mode=OneWay}" Foreground="{Binding Cpu.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Cpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Cpu.TempBrush, Mode=OneWay}"/></TextBlock>
                    <TextBlock FontSize="10.5" Opacity="0.7" Text="{Binding Cpu.ClockText, Mode=OneWay}"/>
                    <c:Sparkline Height="26" Margin="0,3,0,0" Values="{Binding Cpu.History}" Stroke="{DynamicResource Accent}"/>
                </StackPanel>
                <StackPanel x:Name="DRam" Width="176">
                    <TextBlock FontSize="13"><Run Text="{h:Tr 'RAM: '}"/><Run Text="{Binding Ram.LoadText, Mode=OneWay}" Foreground="{Binding Ram.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="10.5" Opacity="0.7"><Run Text="{Binding Ram.UsedText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Ram.TotalText, Mode=OneWay}"/></TextBlock>
                    <c:Sparkline Height="26" Margin="0,3,0,0" Values="{Binding Ram.History}" Stroke="{DynamicResource Accent2}"/>
                </StackPanel>                <StackPanel x:Name="DGpu" Width="176">
                    <TextBlock FontSize="13"><Run Text="{h:Tr 'GPU: '}"/><Run Text="{Binding Gpu.LoadText, Mode=OneWay}" Foreground="{Binding Gpu.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Gpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Gpu.TempBrush, Mode=OneWay}"/></TextBlock>
                    <TextBlock FontSize="10.5" Opacity="0.7" Text="{Binding Gpu.ClockText, Mode=OneWay}"/>
                    <c:Sparkline Height="26" Margin="0,3,0,0" Values="{Binding Gpu.History}" Stroke="{DynamicResource Accent2}"/>
                </StackPanel>
                <StackPanel x:Name="DDisk" Width="176">
                    <TextBlock FontSize="13"><Run Text="{h:Tr 'Disco: '}"/><Run Text="{Binding Disk.LoadText, Mode=OneWay}" Foreground="{Binding Disk.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="10.5" Opacity="0.7" Text="{Binding Disk.IoText, Mode=OneWay}"/>
                    <c:Sparkline Height="26" Margin="0,3,0,0" Values="{Binding Disk.History}" Stroke="{DynamicResource Accent}"/>
                </StackPanel>
                <StackPanel x:Name="DNet" Width="176">
                    <TextBlock FontSize="13"><Run Text="{h:Tr 'NET: ↓ '}"/><Run Text="{Binding Network.Download, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="10.5" Opacity="0.7"><Run Text="↑ "/><Run Text="{Binding Network.Upload, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Network.Latency, Mode=OneWay}"/></TextBlock>
                    <c:Sparkline Height="26" Margin="0,3,0,0" Values="{Binding Network.DownHistory}" Maximum="{Binding Network.RateMax}" Unit="Mbps" Stroke="{DynamicResource Accent}"/>
                </StackPanel>                <StackPanel x:Name="DFps" Width="176">
                    <TextBlock FontSize="13"><Run Text="{h:Tr 'FPS: '}"/><Run Text="{Binding FpsText, Mode=OneWay}" Foreground="{Binding FpsBrush, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="10.5" Opacity="0.7"><Run Text="{h:Tr 'Média: '}"/><Run Text="{Binding FpsAvgText, Mode=OneWay}"/></TextBlock>
                    <c:Sparkline Height="26" Margin="0,3,0,0" Values="{Binding FpsHistory}" Maximum="{Binding FpsMax}" Unit="FPS" Stroke="{DynamicResource Accent}"/>
                </StackPanel>            </StackPanel>
            <StackPanel x:Name="TaskbarPanel" Orientation="Horizontal" Margin="-12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TCpu" FontSize="12" Margin="12,0,0,0">
                    <Run Text="{h:Tr 'CPU '}"/><Run Text="{Binding Cpu.LoadText, Mode=OneWay}" Foreground="{Binding Cpu.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Cpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Cpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TRam" FontSize="12" Margin="12,0,0,0">
                    <Run Text="{h:Tr 'RAM '}"/><Run Text="{Binding Ram.LoadText, Mode=OneWay}" Foreground="{Binding Ram.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock x:Name="TGpu" FontSize="12" Margin="12,0,0,0">
                    <Run Text="{h:Tr 'GPU '}"/><Run Text="{Binding Gpu.LoadText, Mode=OneWay}" Foreground="{Binding Gpu.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Gpu.GadgetTemp, Mode=OneWay}" Foreground="{Binding Gpu.TempBrush, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TVram" FontSize="12" Margin="12,0,0,0">
                    <Run Text="{h:Tr 'Disco '}"/><Run Text="{Binding Disk.LoadText, Mode=OneWay}" Foreground="{Binding Disk.LoadBrush, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock x:Name="TFps" FontSize="12" Margin="12,0,0,0">
                    <Run Text="{h:Tr 'FPS '}"/><Run Text="{Binding FpsText, Mode=OneWay}" Foreground="{Binding FpsBrush, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{h:Tr ' · méd '}"/><Run Text="{Binding FpsAvgText, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock x:Name="TNet" FontSize="12" Margin="12,0,0,0">
                    <Run Text="{h:Tr 'NET ↓ '}"/><Run Text="{Binding Network.Download, Mode=OneWay}"/><Run Text=" ↑ "/><Run Text="{Binding Network.Upload, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="Tools" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,4" Visibility="Hidden">
          <Thumb x:Name="MoveX" Width="20" Height="20" Margin="2,0" Cursor="Arrow" DragStarted="OnMoveXStart" DragDelta="OnMoveXDelta" DragCompleted="OnMoveXDone" MouseDoubleClick="OnMoveXReset">
                  <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                          <Border x:Name="B" CornerRadius="5" Background="{DynamicResource GadgetBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                              <TextBlock Text="↔" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsDragging" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Thumb.Template>
              </Thumb>
              <Button x:Name="BtnView" Style="{StaticResource GadgetToolButton}" Content="▤" Margin="2,0" Click="OnToggleView"/>
              <Button x:Name="BtnFade" Style="{StaticResource GadgetToolButton}" Content="👁" Margin="2,0" Click="OnToggleFade"/>
          </StackPanel>
          <Button x:Name="BtnLock" Grid.Row="0" Style="{StaticResource GadgetToolButton}" Content="🔓" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,4" Visibility="Hidden" Click="OnToggleLock"/>
          <Thumb x:Name="Grip" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,-10,-6" Cursor="Arrow" Visibility="Collapsed"
                 DragStarted="OnGripStart" DragDelta="OnGripDelta" DragCompleted="OnGripDone" MouseDoubleClick="OnGripReset">
              <Thumb.Template>
                  <ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.7"/></Border></ControlTemplate>
              </Thumb.Template>
          </Thumb>
        </Grid>
    </Border>
</Window>
