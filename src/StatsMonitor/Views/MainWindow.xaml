<Window x:Class="StatsMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StatsMonitor.Controls"
        Title="Stats Monitor" Icon="/StatsMonitor.ico" Width="990" MinWidth="990" SizeToContent="Height"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Margin="4,1">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="2" Margin="0,8" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" Margin="10,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorder}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Content" Value="📋"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Copiar para a área de transferência"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style x:Key="TempRow" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasTemperature}" Value="True"/>
                        <Condition Binding="{Binding DataContext.ShowTemperatures, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TempLabelRow" TargetType="TextBlock" BasedOn="{StaticResource TempRow}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- CPU / GPU -->
        <DataTemplate x:Key="ProcessorTemplate">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <c:CircularGauge Width="110" Height="110" Value="{Binding Load}" ToolTip="{Binding Load, StringFormat=Uso neste momento: {0:0.0}%}"
                                         Accent="{DynamicResource Accent}" Track="{DynamicResource TrackBrush}"
                                         TextBrush="{DynamicResource TextPrimary}"/>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Frequência" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ClockText}" FontSize="16" Margin="0,0,0,8"/>
                            <StackPanel Visibility="{Binding DataContext.ShowTemperatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Temperatura" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding TempText}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding TempBrush}"/>
                                <TextBlock Text="{Binding MinMaxText}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <c:Sparkline Height="60" Margin="0,12,0,0" Values="{Binding History}" Stroke="{DynamicResource Accent}"/>
                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MinWidth="130" Margin="0,0,14,6">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- RAM / VRAM -->
        <DataTemplate x:Key="MemoryTemplate">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent2}"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <c:CircularGauge Width="110" Height="110" Value="{Binding Load}" ToolTip="{Binding Load, StringFormat=Uso neste momento: {0:0.0}%}"
                                         Accent="{DynamicResource Accent2}" Track="{DynamicResource TrackBrush}"
                                         TextBrush="{DynamicResource TextPrimary}"/>
                        <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Total" Style="{StaticResource Caption}" Margin="0,2,14,2"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Usada" Style="{StaticResource Caption}" Margin="0,2,14,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Disponível" Style="{StaticResource Caption}" Margin="0,2,14,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvailableText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Temp." Margin="0,2,14,2" Style="{StaticResource TempLabelRow}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TempText}" Foreground="{Binding TempBrush}" FontWeight="SemiBold" Margin="0,2"
                                       Style="{StaticResource TempRow}"/>
                        </Grid>
                    </Grid>
                    <c:Sparkline Height="60" Margin="0,12,0,0" Values="{Binding History}" Stroke="{DynamicResource Accent2}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
        <StackPanel x:Name="NavPanel" Width="48" Margin="0,6">
            <Button x:Name="NavMenu" Style="{StaticResource NavButton}" ToolTip="Menu" Click="OnToggleMenu">
                <StackPanel Orientation="Horizontal"><TextBlock Text="☰" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="LblMenu" Text="Menu" FontWeight="SemiBold" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavMain" Style="{StaticResource NavButton}" Tag="active" ToolTip="Tela principal" Click="OnNavMain">
                <StackPanel Orientation="Horizontal"><TextBlock Text="📊" FontSize="16" Width="24" TextAlignment="Center"/><TextBlock x:Name="LblMain" Text="Principal" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" ToolTip="Intervalo, painéis exibidos, gadget e limites de temperatura" Click="OnOpenSettings">
                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="24" TextAlignment="Center"/><TextBlock x:Name="LblSettings" Text="Configurações" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavAppearance" Style="{StaticResource NavButton}" ToolTip="Temas, cores e presets de personalização" Click="OnOpenAppearance">
                <StackPanel Orientation="Horizontal"><TextBlock Text="🎨" FontSize="16" Width="24" TextAlignment="Center"/><TextBlock x:Name="LblAppearance" Text="Personalização" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel>
            </Button>
        </StackPanel>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Column="1" Margin="14" Visibility="Collapsed" IsTabStop="False"/>

    <Grid x:Name="MainPage" Grid.Column="1" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="6,0,6,6">
            <Button DockPanel.Dock="Right" Content="🛡" FontSize="16" Style="{StaticResource PillButton}" ToolTip="Executar como administrador: reabre o app com privilégios elevados (necessário para temperaturas)" Click="OnRunAsAdmin" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="Monitor" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,4"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="CardsGrid">
        <ContentControl x:Name="CpuCard" MinHeight="260" Content="{Binding Cpu}" ContentTemplate="{StaticResource ProcessorTemplate}"/>
        <ContentControl x:Name="GpuCard" MinHeight="260" Content="{Binding Gpu}" ContentTemplate="{StaticResource ProcessorTemplate}"/>
        <ContentControl x:Name="RamCard" MinHeight="260" Content="{Binding Ram}" ContentTemplate="{StaticResource MemoryTemplate}"/>
        <ContentControl x:Name="VramCard" MinHeight="260" Content="{Binding Vram}" ContentTemplate="{StaticResource MemoryTemplate}"/>

        <Border x:Name="NetCard" Style="{StaticResource Card}" DataContext="{Binding Network}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E0A030"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                            <Setter Property="Fill" Value="#3CC47C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock Text="Rede / Internet" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="↓ Download" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Download}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TotalReceived, StringFormat=Sessão: {0}}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="↑ Upload" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Upload}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TotalSent, StringFormat=Sessão: {0}}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="Latência" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Latency}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Link, StringFormat=Link: {0}}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="Conexão" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Adapter}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Adapter}"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Caption}" Text="{Binding Ip, StringFormat=IP: {0}}" VerticalAlignment="Center"/><Button Style="{StaticResource CopyButton}" Tag="{Binding Ip}" Click="OnCopy"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Caption}" Text="{Binding Gateway, StringFormat=Gateway: {0}}" VerticalAlignment="Center"/><Button Style="{StaticResource CopyButton}" Tag="{Binding Gateway}" Click="OnCopy"/></StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="FooterCard" Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="Tempo ligado" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding UptimeText}" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="Última atualização" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding LastUpdateText}" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <TextBlock Text="Status do hardware" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="16"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding SensorNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
