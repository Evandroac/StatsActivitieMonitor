<Window x:Class="StatsMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StatsMonitor.Controls"
        xmlns:h="clr-namespace:StatsMonitor.Helpers"
        Title="{h:Tr 'Stats Monitor'}" Icon="/StatsMonitor.ico" Width="990" MinWidth="990" SizeToContent="Height"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Margin="4,1">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="2" Margin="0,8" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorder}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Content" Value="📋"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{h:Tr 'Copiar para a área de transferência'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <Style x:Key="TempRow" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasTemperature}" Value="True"/>
                        <Condition Binding="{Binding DataContext.ShowTemperatures, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TempLabelRow" TargetType="TextBlock" BasedOn="{StaticResource TempRow}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- CPU / GPU -->
        <DataTemplate x:Key="ProcessorTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AlertLevel}" Value="1">
                                <Setter Property="Background" Value="{Binding AlertBackground}"/>
                                <Setter Property="BorderBrush" Value="{Binding AlertBorder}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AlertLevel}" Value="2">
                                <Setter Property="Background" Value="{Binding AlertBackground}"/>
                                <Setter Property="BorderBrush" Value="{Binding AlertBorder}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF4D4F" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/></Setter.Value></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title, Converter={x:Static h:TitleIcon.Instance}}" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10"><Button Style="{StaticResource CopyButton}" Tag="{Binding Name}" Click="OnCopy"/><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <c:CircularGauge Width="110" Height="110" Value="{Binding Load}" ToolTip="{Binding Load, StringFormat=Uso neste momento: {0:0.0}%}"
                                         Accent="{DynamicResource Accent}" Track="{DynamicResource TrackBrush}"
                                         TextBrush="{DynamicResource TextPrimary}"/>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:Tr 'Frequência'}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ClockText}" FontSize="16" Margin="0,0,0,8"/>
                            <StackPanel Visibility="{Binding DataContext.ShowTemperatures, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{h:Tr 'Temperatura'}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding TempText}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding TempBrush}"/>
                                <TextBlock Text="{Binding MinMaxText}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <c:Sparkline Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}" Height="60" Margin="0,12,0,0" Values="{Binding History}" Stroke="{DynamicResource Accent}"/>
                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MinWidth="130" Margin="0,0,14,6">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- RAM / VRAM -->
        <DataTemplate x:Key="MemoryTemplate">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title, Converter={x:Static h:TitleIcon.Instance}}" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent2}" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <c:CircularGauge Width="110" Height="110" Value="{Binding Load}" ToolTip="{Binding Load, StringFormat=Uso neste momento: {0:0.0}%}"
                                         Accent="{DynamicResource Accent2}" Track="{DynamicResource TrackBrush}"
                                         TextBrush="{DynamicResource TextPrimary}"/>
                        <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{h:Tr 'Total'}" Style="{StaticResource Caption}" Margin="0,2,14,2"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="{h:Tr 'Usada'}" Style="{StaticResource Caption}" Margin="0,2,14,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="{h:Tr 'Disponível'}" Style="{StaticResource Caption}" Margin="0,2,14,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvailableText}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="{h:Tr 'Temp.'}" Margin="0,2,14,2" Style="{StaticResource TempLabelRow}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TempText}" Foreground="{Binding TempBrush}" FontWeight="SemiBold" Margin="0,2"
                                       Style="{StaticResource TempRow}"/>
                        </Grid>
                    </Grid>
                    <c:Sparkline Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}" Height="60" Margin="0,12,0,0" Values="{Binding History}" Stroke="{DynamicResource Accent2}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,6">
        <Button x:Name="NavPin" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" ToolTip="{h:Tr 'Alternar menu lateral: fixar visível ou deixar recolhido (fica salvo)'}" AutomationProperties.Name="{h:Tr 'Alternar menu lateral: fixar visível ou deixar recolhido (fica salvo)'}" Click="OnTogglePin">
                <StackPanel Orientation="Horizontal"><TextBlock Text="📌" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/></StackPanel>
            </Button>
        <StackPanel x:Name="NavPanel" Width="48">
            <Button x:Name="NavMenu" Style="{StaticResource NavButton}" ToolTip="{h:Tr 'Menu'}" AutomationProperties.Name="{h:Tr 'Menu'}" Click="OnToggleMenu">
                <StackPanel Orientation="Horizontal"><TextBlock Text="☰" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/><TextBlock x:Name="LblMenu" Text="{h:Tr 'Menu'}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Grid x:Name="SearchRow" Height="40" Margin="4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SearchIcon" Style="{StaticResource NavButton}" Margin="-4,-1" Width="48" ToolTip="{h:Tr 'Pesquisar'}" AutomationProperties.Name="{h:Tr 'Pesquisar'}" Click="OnSearchIcon">
                    <TextBlock Text="🔍" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/>
                </Button>
                <TextBox x:Name="SearchBox" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0,4,0" Padding="4,4"
                         Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" CaretBrush="{DynamicResource TextPrimary}"
                         h:Hint.Text="{h:Tr 'Pesquisar…'}" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey"/>
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchRow}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,2,8,8" MinWidth="300" MaxWidth="420">
                        <ListBox x:Name="SearchList" MaxHeight="320" Background="Transparent" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnSearchClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
            <Button x:Name="NavMain" Style="{StaticResource NavButton}" Tag="active" ToolTip="{h:Tr 'Tela principal'}" AutomationProperties.Name="{h:Tr 'Tela principal'}" Click="OnNavMain">
                <StackPanel Orientation="Horizontal"><TextBlock Text="📊" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/><TextBlock x:Name="LblMain" Text="{h:Tr 'Principal'}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavSystem" Style="{StaticResource NavButton}" ToolTip="{h:Tr 'Informações do computador'}" AutomationProperties.Name="{h:Tr 'Informações do computador'}" Click="OnOpenSystem">
                <StackPanel Orientation="Horizontal"><TextBlock Text="ℹ️" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/><TextBlock x:Name="LblSystem" Text="{h:Tr 'Sistema'}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavPeripherals" Style="{StaticResource NavButton}" ToolTip="{h:Tr 'Periféricos conectados: monitores, teclado, mouse, áudio, câmeras e mais'}" AutomationProperties.Name="{h:Tr 'Periféricos conectados: monitores, teclado, mouse, áudio, câmeras e mais'}" Click="OnOpenPeripherals">
                <StackPanel Orientation="Horizontal"><TextBlock Text="🖱️" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/><TextBlock x:Name="LblPeripherals" Text="{h:Tr 'Periféricos'}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavAppearance" Style="{StaticResource NavButton}" ToolTip="{h:Tr 'Temas, cores e presets de personalização'}" AutomationProperties.Name="{h:Tr 'Temas, cores e presets de personalização'}" Click="OnOpenAppearance">
                <StackPanel Orientation="Horizontal"><TextBlock Text="🎨" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/><TextBlock x:Name="LblAppearance" Text="{h:Tr 'Personalização'}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
            </Button>
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" ToolTip="{h:Tr 'Intervalo, painéis exibidos, gadget e limites de temperatura'}" AutomationProperties.Name="{h:Tr 'Intervalo, painéis exibidos, gadget e limites de temperatura'}" Click="OnOpenSettings">
                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontSize="16" Width="24" TextAlignment="Center" FontFamily="Segoe UI Emoji,Segoe UI Symbol" VerticalAlignment="Center"/><TextBlock x:Name="LblSettings" Text="{h:Tr 'Configurações'}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
            </Button>
        </StackPanel>
        </DockPanel>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Column="1" Margin="14,58,14,14" Visibility="Collapsed" IsTabStop="False"/>
    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" Content="📋" FontSize="16" Style="{StaticResource PillButton}" ToolTip="{h:Tr 'Copiar todas as informações exibidas na tela neste momento'}" AutomationProperties.Name="{h:Tr 'Copiar todas as informações exibidas na tela neste momento'}" Click="OnCopyAll" Visibility="{Binding Visibility, ElementName=PageHost}"/>

    <Grid x:Name="MainPage" Grid.Column="1" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="6,0,6,6">
            <Button DockPanel.Dock="Right" Content="🛡" FontSize="16" Style="{StaticResource PillButton}" ToolTip="{h:Tr 'Executar como administrador: reabre o app com privilégios elevados (necessário para temperaturas)'}" AutomationProperties.Name="{h:Tr 'Executar como administrador: reabre o app com privilégios elevados (necessário para temperaturas)'}" Click="OnRunAsAdmin" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="📋" FontSize="16" Style="{StaticResource PillButton}" ToolTip="{h:Tr 'Copiar todas as informações exibidas na tela neste momento'}" AutomationProperties.Name="{h:Tr 'Copiar todas as informações exibidas na tela neste momento'}" Click="OnCopyAll" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="{h:Tr 'Monitor'}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,4"/>
            <CheckBox x:Name="ChkSimple" Content="{h:Tr '🍃  Visualização simplificada'}" VerticalAlignment="Center" Margin="0,0,0,4" ToolTip="{h:Tr 'Visualização simplificada: sem gráficos, sem rede/sensores e atualização mais lenta para economizar recursos'}" AutomationProperties.Name="{h:Tr 'Visualização simplificada'}" Click="OnToggleSimplified"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="CardsGrid">
        <ContentControl x:Name="CpuCard" MinHeight="260" Content="{Binding Cpu}" ContentTemplate="{StaticResource ProcessorTemplate}"/>
        <ContentControl x:Name="GpuCard" MinHeight="260" Content="{Binding Gpu}" ContentTemplate="{StaticResource ProcessorTemplate}"/>
        <ContentControl x:Name="RamCard" MinHeight="260" Content="{Binding Ram}" ContentTemplate="{StaticResource MemoryTemplate}"/>
        <Border x:Name="VramCard" Style="{StaticResource Card}" MinHeight="260" DataContext="{Binding Disk}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="💽" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Discos (HD/SSD)'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent2}" VerticalAlignment="Center"/></StackPanel>
                <ItemsControl ItemsSource="{Binding Volumes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Free}" Style="{StaticResource Caption}"/>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource CopyButton}" Margin="6,0,0,0" Content="📂" ToolTip="{h:Tr 'Abrir o disco no Explorador de Arquivos'}" AutomationProperties.Name="{h:Tr 'Abrir o disco no Explorador de Arquivos'}" Tag="{Binding Name}" Click="OnOpenFolder"/></StackPanel>
                                </DockPanel>
                                <ProgressBar Height="8" Margin="0,3" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{DynamicResource Accent2}" Background="{DynamicResource TrackBrush}" BorderThickness="0"/>
                                <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,6">
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource CopyButton}" Tag="{Binding Name}" Click="OnCopy"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></StackPanel>
                                <WrapPanel>
                                    <StackPanel MinWidth="100" Margin="0,0,12,4"><TextBlock Text="{h:Tr 'Temperatura'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Temp}"/></StackPanel>
                                    <StackPanel MinWidth="100" Margin="0,0,12,4"><TextBlock Text="{h:Tr 'Leitura'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Read}"/></StackPanel>
                                    <StackPanel MinWidth="100" Margin="0,0,12,4"><TextBlock Text="{h:Tr 'Escrita'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Write}"/></StackPanel>
                                    <StackPanel MinWidth="100" Margin="0,0,12,4"><TextBlock Text="{h:Tr 'Tempo de atividade'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Activity}"/></StackPanel>
                                    <StackPanel MinWidth="100" Margin="0,0,12,4"><TextBlock Text="{h:Tr 'Saúde SMART'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Health}"/></StackPanel>
                                    <StackPanel MinWidth="100" Margin="0,0,12,4"><TextBlock Text="{h:Tr 'Vida útil'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Life}"/></StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="NetCard" Style="{StaticResource Card}" DataContext="{Binding Network}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E0A030"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                            <Setter Property="Fill" Value="#3CC47C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🌐" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Rede / Internet'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></StackPanel>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="{h:Tr '↓ Download'}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Download}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TotalReceived, StringFormat=Sessão: {0}}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="{h:Tr '↑ Upload'}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Upload}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding TotalSent, StringFormat=Sessão: {0}}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="{h:Tr 'Latência'}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Latency}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Link, StringFormat=Link: {0}}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="{h:Tr 'Conexão'}" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource CopyButton}" Tag="{Binding Adapter}" Click="OnCopy"/><TextBlock Text="{Binding Adapter}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Adapter}" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource CopyButton}" Tag="{Binding Ip}" Click="OnCopy"/><TextBlock Style="{StaticResource Caption}" Text="{Binding Ip, StringFormat=IP: {0}}" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource CopyButton}" Tag="{Binding Gateway}" Click="OnCopy"/><TextBlock Style="{StaticResource Caption}" Text="{Binding Gateway, StringFormat=Gateway: {0}}" VerticalAlignment="Center"/></StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="SensorsCard" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="🌀" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Sensores'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="{h:Tr 'Nenhum sensor adicional disponível (execute como administrador).'}">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasSensors}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding SensorLines}" AutomationProperties.Name="{h:Tr 'Sensores'}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="FooterCard" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="📈" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Status do sistema'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></StackPanel>
                <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⏱️" FontFamily="Segoe UI Emoji" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Tempo ligado'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="{Binding UptimeText}" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🔄" FontFamily="Segoe UI Emoji" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Última atualização'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="{Binding LastUpdateText}" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🩺" FontFamily="Segoe UI Emoji" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{h:Tr 'Status do hardware'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="16"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding SensorNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
