<Window x:Class="StatsMonitor.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats Monitor" Width="580" Height="400" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Border CornerRadius="18" Margin="16" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Border Height="150" VerticalAlignment="Top" IsHitTestVisible="False" CornerRadius="18,18,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#33000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Grid Margin="32,30,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="60" Height="60">
                        <Ellipse Width="60" Height="60" Opacity="0.35" x:Name="LogoGlow">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0.4"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform><ScaleTransform CenterX="30" CenterY="30"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="Opacity" From="0.2" To="0.7" Duration="0:0:1.4"/>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1.25" Duration="0:0:1.4"/>
                                            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1.25" Duration="0:0:1.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Border Width="48" Height="48" CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Accent2Color}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Stats Monitor" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="Light"/>
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,22,0,18" CornerRadius="10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <Grid>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Hidden" Padding="14,10">
                            <TextBlock x:Name="LogText" Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                        </ScrollViewer>
                        <Border Height="22" VerticalAlignment="Top" CornerRadius="10,10,0,0" IsHitTestVisible="False" Background="{DynamicResource CardBg}" Opacity="0.85">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                        <TextBlock x:Name="PercentText" Foreground="{DynamicResource Accent}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="8" CornerRadius="4" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                        <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Accent2Color}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="MinimizeBtn" Content="Minimizar" Margin="0,0,8,0" MinWidth="96" Style="{StaticResource PillButton}" Click="OnMinimize"/>
                        <Button x:Name="CancelBtn" Content="Cancelar" MinWidth="96" Style="{StaticResource PillButton}" Click="OnCancel"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
