<Window x:Class="StatsMonitor.Views.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalização" Width="480" SizeToContent="Height" MaxHeight="800" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}" FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="ColorRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Hexadecimal (#RRGGBB ou #AARRGGBB). Vazio = padrão do tema"/>
                <Border Grid.Column="2" Width="40" Height="22" CornerRadius="4" Background="{Binding Preview}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Tema base" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="Theme" Content="Escuro" IsChecked="{Binding DarkTheme}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0"/>
                <RadioButton GroupName="Theme" Content="Claro" IsChecked="{Binding LightTheme}" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <TextBlock Text="Janela principal (maximizada)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
            <ItemsControl ItemsSource="{Binding MainOptions}" ItemTemplate="{StaticResource ColorRow}"/>

            <TextBlock Text="Gadget (minimizado)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
            <ItemsControl ItemsSource="{Binding GadgetOptions}" ItemTemplate="{StaticResource ColorRow}"/>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding GadgetOpacity, StringFormat=Opacidade do fundo: {0}%}" Width="200" VerticalAlignment="Center"/>
                <Slider Minimum="10" Maximum="100" Width="200" HorizontalAlignment="Left" Value="{Binding GadgetOpacity}"/>
            </DockPanel>

            <TextBlock Text="Cores dos alertas de temperatura" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
            <ItemsControl ItemsSource="{Binding AlertOptions}" ItemTemplate="{StaticResource ColorRow}"/>

            <TextBlock Text="Deixe o campo vazio para usar a cor padrão do tema." Style="{StaticResource Caption}" Margin="0,12,0,0"/>

            <DockPanel Margin="0,20,0,0">
                <Button DockPanel.Dock="Left" Content="Restaurar padrões" Style="{StaticResource PillButton}" Command="{Binding ResetCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource PillButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Aplicar" Style="{StaticResource PillButton}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
                    <Button Content="Salvar" Style="{StaticResource PillButton}" IsDefault="True" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
