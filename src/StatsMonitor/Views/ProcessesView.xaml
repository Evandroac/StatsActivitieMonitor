<UserControl x:Class="StatsMonitor.Views.ProcessesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="8,6" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding Tip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource TextPrimary}" Opacity="0"/>
                            <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource Accent}" Opacity="0" BorderBrush="{DynamicResource Accent}" BorderThickness="1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Sel" Property="Opacity" Value="0.22"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCell" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <DataTemplate x:Key="ProcRow">
            <Grid MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                    <Button Content="{Binding Glyph}" Visibility="{Binding ExpanderVisibility}" Style="{StaticResource HeaderButton}" Width="22" Height="22" Padding="0" Click="OnToggleExpand" Focusable="False"/>
                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding NameText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource MetricCell}" Background="{Binding CpuBrush}"><TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right"/></Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCell}" Background="{Binding MemBrush}" ToolTip="{Binding MemTip}"><TextBlock Text="{Binding MemText}" HorizontalAlignment="Right"/></Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCell}" Background="{Binding DiskBrush}" ToolTip="{Binding DiskTip}"><TextBlock Text="{Binding DiskText}" HorizontalAlignment="Right"/></Border>
                <Border Grid.Column="5" Style="{StaticResource MetricCell}" Background="{Binding NetBrush}" ToolTip="{Binding NetTip}"><TextBlock Text="{Binding NetText}" HorizontalAlignment="Right"/></Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,4,0,0"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="220" Margin="0,0,8,0" TextChanged="OnQueryChanged" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="TypeBox" Width="150" Margin="0,0,8,0" SelectionChanged="OnQueryChanged"/>
                <ComboBox x:Name="StatusBox" Width="150" Margin="0,0,8,0" SelectionChanged="OnQueryChanged"/>
                <ComboBox x:Name="SortBox" Width="150" Margin="0,0,4,0" SelectionChanged="OnQueryChanged"/>
                <Button x:Name="DirButton" Style="{StaticResource PillButton}" Width="40" Margin="0,0,8,0" Click="OnToggleDirection"/>
                <ComboBox x:Name="RefreshBox" Width="120" Margin="0,0,16,0" SelectionChanged="OnRefreshChanged"/>
                <Button x:Name="ExpandButton" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="OnExpandAll"/>
                <Button x:Name="CollapseButton" Style="{StaticResource PillButton}" Margin="0,0,16,0" Click="OnCollapseAll"/>
                <Button x:Name="EndButton" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="OnEndTask"/>
                <Button x:Name="RestartButton" Style="{StaticResource PillButton}" Click="OnRestart"/>
            </WrapPanel>
        </Border>

        <Border x:Name="DetailsCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" LineHeight="20"/>
        </Border>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HName" Grid.Column="0" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" Click="OnHeaderClick"/>
                    <Button x:Name="HStatus" Grid.Column="1" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Left" IsHitTestVisible="False"/>
                    <Button x:Name="HCpu" Grid.Column="2" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Click="OnHeaderClick"/>
                    <Button x:Name="HMem" Grid.Column="3" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Click="OnHeaderClick"/>
                    <Button x:Name="HDisk" Grid.Column="4" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Click="OnHeaderClick"/>
                    <Button x:Name="HNet" Grid.Column="5" Style="{StaticResource HeaderButton}" HorizontalContentAlignment="Right" Click="OnHeaderClick"/>
                </Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource ProcRow}"
                         ItemContainerStyle="{StaticResource RowItem}" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnListKeyDown"
                         ContextMenuOpening="OnContextMenuOpening"/>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
