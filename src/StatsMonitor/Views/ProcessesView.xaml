<UserControl x:Class="StatsMonitor.Views.ProcessesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:StatsMonitor.Services"
        xmlns:local="clr-namespace:StatsMonitor.Views"
        xmlns:h="clr-namespace:StatsMonitor.Helpers"
        FontFamily="{DynamicResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="8,6" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="{Binding Tip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource TextPrimary}" Opacity="0"/>
                            <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource Accent}" Opacity="0" BorderBrush="{DynamicResource Accent}" BorderThickness="1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Sel" Property="Opacity" Value="0.22"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColSplit" TargetType="Thumb">
            <Setter Property="Width" Value="8"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Rectangle Width="1" Margin="0,8" Fill="{DynamicResource ControlBorder}"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="MetricCell" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <DataTemplate x:Key="ProcRow"><local:ProcRowPanel/></DataTemplate>
    </UserControl.Resources>

    <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Margin="16,20,0,20" Padding="14" VerticalAlignment="Top" CornerRadius="12" Width="240" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{h:Tr 'AÇÕES'}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <TextBlock x:Name="ActionsHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,12"/>
            <Button x:Name="ExpandButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnExpandAll"/>
            <Button x:Name="CollapseButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnCollapseAll"/>
            <Separator Margin="0,2,0,10"/>
            <Button x:Name="EndButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnEndTask"/>
            <Button x:Name="EndTreeButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnEndTree"/>
            <Button x:Name="RestartButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnRestart"/>
            <Separator Margin="0,2,0,10"/>
            <Button x:Name="PriorityButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnPriorityButton"/>
            <Button x:Name="LocationButton" Style="{StaticResource PillButton}" Margin="0,0,0,8" Click="OnOpenLocationButton"/>
            <Button x:Name="CopyButton" Style="{StaticResource PillButton}" Click="OnCopyPathButton"/>
        </StackPanel>
    </Border>
    <DockPanel Grid.Column="1" Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,4,0,0"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <WrapPanel>
                <Grid Width="240" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" TextChanged="OnQueryChanged" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <ComboBox x:Name="TypeBox" Width="150" Margin="0,0,8,0" SelectionChanged="OnQueryChanged"/>
                <ComboBox x:Name="StatusBox" Width="150" Margin="0,0,8,0" SelectionChanged="OnQueryChanged"/>
                <ComboBox x:Name="SortBox" Width="150" Margin="0,0,4,0" SelectionChanged="OnQueryChanged"/>
                <Button x:Name="DirButton" Style="{StaticResource PillButton}" Width="40" Margin="0,0,8,0" Click="OnToggleDirection"/>
                <ComboBox x:Name="RefreshBox" Width="120" Margin="0,0,8,0" SelectionChanged="OnRefreshChanged"/>
                <Button x:Name="ColumnsButton" Style="{StaticResource PillButton}" Click="OnColumnsButton"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0" Height="210">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <ComboBox x:Name="MetricBox" DockPanel.Dock="Right" Width="130" SelectionChanged="OnMetricChanged"/>
                    <TextBlock x:Name="ChartTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ChartHint" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <local:ProcessTimeline x:Name="Chart"/>
            </DockPanel>
        </Border>

        <Border x:Name="DetailsCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" LineHeight="20"/>
        </Border>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <Grid x:Name="HeaderGrid" DockPanel.Dock="Top" Margin="0,0,10,4"/>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource ProcRow}"
                         ItemContainerStyle="{StaticResource RowItem}" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="OnSelectionChanged"
                         Button.Click="OnToggleExpand" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnListKeyDown"
                         PreviewMouseRightButtonDown="OnRowRightClick" ContextMenuOpening="OnContextMenuOpening"/>
            </DockPanel>
        </Border>
    </DockPanel>
    </Grid>
</UserControl>