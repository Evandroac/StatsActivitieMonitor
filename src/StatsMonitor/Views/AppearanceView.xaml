<UserControl x:Class="StatsMonitor.Views.AppearanceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:StatsMonitor.Helpers"
        FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12" BorderThickness="2" Padding="8" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource ControlBorder}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Badge" Visibility="Collapsed" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <h:BoolTextConverter x:Key="CustomText" TrueText="Personalizada" FalseText="Padrão do tema"/>
        <DataTemplate x:Key="ColorRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left" h:Hint.Text="{Binding DefaultHex, Mode=OneWay}" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{h:Tr 'Hexadecimal (#RRGGBB ou #AARRGGBB). Vazio = padrão do tema'}"/>
                <ToggleButton x:Name="Toggle" Grid.Column="2" Width="40" Height="22" Cursor="Hand" ToolTip="{h:Tr 'Abrir seletor RGB'}"
                              IsChecked="{Binding IsOpen, ElementName=Pop, Mode=TwoWay}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Sw" CornerRadius="4" Background="{Binding Preview}" BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1"/>
                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Sw" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen, ElementName=Pop}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Left" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                            CornerRadius="10" Padding="14" Margin="8">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
                        <StackPanel Width="260">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding IsCustom, Converter={StaticResource CustomText}}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Border Height="44" CornerRadius="6" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Background="{Binding Preview}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="1" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding HexText, StringFormat=HEX:  {0}}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding RgbText, StringFormat=RGB:  {0}}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding HslText, StringFormat=HSL:  {0}}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Contrast}"/>
                            </UniformGrid>
                            <DockPanel><TextBlock Text="R" Width="18" Foreground="#FF5555"/><TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding R, StringFormat={}{0:0}}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding R}"/></DockPanel>
                            <DockPanel><TextBlock Text="G" Width="18" Foreground="#55DD55"/><TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding G, StringFormat={}{0:0}}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding G}"/></DockPanel>
                            <DockPanel><TextBlock Text="B" Width="18" Foreground="#5599FF"/><TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding B, StringFormat={}{0:0}}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding B}"/></DockPanel>
                            <DockPanel><TextBlock Text="A" Width="18" Foreground="{DynamicResource TextSecondary}"/><TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right" Text="{Binding AlphaText}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding A}"/></DockPanel>
                            <TextBlock Text="{h:Tr 'Cores rápidas'}" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{x:Static h:ColorPalette.Colors}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="22" Height="22" Margin="0,0,5,5" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding}" Click="OnSwatch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Sw" CornerRadius="11" BorderThickness="1" BorderBrush="#66808080" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sw" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Sw" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{h:Tr 'Usar padrão do tema'}" Style="{StaticResource PillButton}" Margin="0,6,0,0" Click="OnSwatchDefault"/>
                        </StackPanel>
                    </Border>
                </Popup>            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Margin="16,20,0,20" Padding="14" VerticalAlignment="Top" CornerRadius="12" Width="240" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{h:Tr 'AÇÕES'}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <TextBlock Text="{h:Tr 'As alterações são salvas automaticamente.'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,12"/>
            <Button Content="{h:Tr '↺  Restaurar padrões'}" ToolTip="{h:Tr 'Limpa todas as cores e volta ao padrão do tema'}" AutomationProperties.Name="{h:Tr 'Limpa todas as cores e volta ao padrão do tema'}" Style="{StaticResource PillButton}" Command="{Binding ResetCommand}"/>
        </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{h:Tr '⭐  Minhas personalizações'}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Grid Width="300">
                    <TextBox x:Name="PresetBox" TextChanged="OnPresetTextChanged" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Padding="4,5,28,5" h:Hint.Text="{h:Tr 'Digite um nome ou escolha uma personalização salva'}" ToolTip="{h:Tr 'Nome da personalização: digite para criar ou clique na seta para escolher uma salva'}"/>
                    <ToggleButton x:Name="PresetToggle" HorizontalAlignment="Right" Width="26" Content="▾" Cursor="Hand" Background="Transparent"
                                  Foreground="{DynamicResource TextSecondary}" BorderThickness="0" ToolTip="{h:Tr 'Mostrar personalizações salvas'}"
                                  IsChecked="{Binding IsOpen, ElementName=PresetPopup, Mode=TwoWay}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=PresetPopup}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,2,6,6" Width="{Binding ActualWidth, ElementName=PresetBox}" MaxHeight="220">
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" SelectionChanged="OnPresetPicked"
                                     Background="Transparent" BorderThickness="0" DisplayMemberPath="Name" Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </Popup>
                </Grid>
                <Button Content="{h:Tr 'Salvar como'}" ToolTip="{h:Tr 'Salva as cores atuais com o nome do campo (substitui se o nome já existir)'}" AutomationProperties.Name="{h:Tr 'Salva as cores atuais com o nome do campo (substitui se o nome já existir)'}" Style="{StaticResource PillButton}" Command="{Binding SavePresetCommand}" Margin="8,0,0,0"/>
                <Button Content="{h:Tr 'Carregar'}" ToolTip="{h:Tr 'Carrega como prévia a personalização com o nome do campo'}" AutomationProperties.Name="{h:Tr 'Carrega como prévia a personalização com o nome do campo'}" Style="{StaticResource PillButton}" Command="{Binding LoadPresetCommand}" Margin="8,0,0,0"/>
                <Button Content="{h:Tr 'Excluir'}" ToolTip="{h:Tr 'Exclui a personalização com o nome do campo'}" AutomationProperties.Name="{h:Tr 'Exclui a personalização com o nome do campo'}" Style="{StaticResource PillButton}" Command="{Binding DeletePresetCommand}" Margin="8,0,0,0"/>
            </StackPanel>            <TextBlock Text="{h:Tr 'Carregar uma personalização aplica as cores na hora. Todas as alterações são salvas automaticamente.'}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{h:Tr '🌗  Tema base'}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Tag="Escuro" ToolTip="{h:Tr 'Usa as cores escuras como base'}" IsChecked="{Binding DarkTheme}" Style="{StaticResource ThemeCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <Border Width="120" Height="64" CornerRadius="8" Background="#12141A" BorderBrush="#40808080" BorderThickness="1" Padding="8">
                                    <Border Background="#1B1E27" CornerRadius="5" Padding="6" BorderBrush="#30808080" BorderThickness="1">
                                        <StackPanel>
                                            <Border Height="5" Width="44" CornerRadius="2.5" Background="#ECEFF4" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="70" CornerRadius="2.5" Background="#ECEFF4" Opacity="0.5" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                            <Border Height="6" Width="30" CornerRadius="3" Background="#4DA3FF" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <TextBlock Text="{h:Tr '🌙  Escuro'}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton>                        <RadioButton GroupName="Theme" Tag="Claro" ToolTip="{h:Tr 'Usa as cores claras como base'}" IsChecked="{Binding LightTheme}" Style="{StaticResource ThemeCard}" Margin="0">
                            <StackPanel>
                                <Border Width="120" Height="64" CornerRadius="8" Background="#EEF1F6" BorderBrush="#40808080" BorderThickness="1" Padding="8">
                                    <Border Background="#FFFFFF" CornerRadius="5" Padding="6" BorderBrush="#30808080" BorderThickness="1">
                                        <StackPanel>
                                            <Border Height="5" Width="44" CornerRadius="2.5" Background="#1B1F2A" HorizontalAlignment="Left"/>
                                            <Border Height="5" Width="70" CornerRadius="2.5" Background="#1B1F2A" Opacity="0.5" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                            <Border Height="6" Width="30" CornerRadius="3" Background="#1F7AE0" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <TextBlock Text="{h:Tr '☀  Claro'}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton>                    </StackPanel>
                    <Border Margin="0,10,0,0" CornerRadius="8" Padding="10" BorderThickness="1" BorderBrush="#40808080" Background="{Binding MainOptions[0].Preview}"
                            ToolTip="{h:Tr 'Pré-visualização do sistema com o tema e as cores escolhidas'}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{Binding MainOptions[4].Preview}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{h:Tr '☀ Claro'}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding DarkTheme}" Value="True"><Setter Property="Text" Value="{h:Tr '🌙 Escuro'}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{h:Tr 'Monitor'}" FontWeight="SemiBold" Foreground="{Binding MainOptions[3].Preview}"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{Binding MainOptions[1].Preview}" BorderBrush="{Binding MainOptions[2].Preview}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{h:Tr '🧠  CPU'}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding MainOptions[5].Preview}"/>
                                        <TextBlock Text="23%  ·  52°C" FontSize="14" Margin="0,4,0,6" Foreground="{Binding MainOptions[3].Preview}"/>
                                        <Border Height="6" CornerRadius="3" Background="{Binding MainOptions[7].Preview}"><Border Width="40" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding MainOptions[5].Preview}"/></Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{Binding MainOptions[1].Preview}" BorderBrush="{Binding MainOptions[2].Preview}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{h:Tr '🧩  Memória'}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding MainOptions[6].Preview}"/>
                                        <TextBlock Text="41%  ·  13,2 GB" FontSize="14" Margin="0,4,0,6" Foreground="{Binding MainOptions[3].Preview}"/>
                                        <Border Height="6" CornerRadius="3" Background="{Binding MainOptions[7].Preview}"><Border Width="70" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding MainOptions[6].Preview}"/></Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{h:Tr 'Texto secundário de exemplo'}" FontSize="11" Margin="0,8,0,0" Foreground="{Binding MainOptions[4].Preview}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{h:Tr '🪟  Gadget (minimizado)'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding GadgetOptions}" ItemTemplate="{StaticResource ColorRow}"/>
                    <TextBlock Text="{Binding GadgetOpacity, StringFormat=Opacidade do fundo: {0}%}" Margin="0,6,0,0"/>
                    <Slider Minimum="10" Maximum="100" Value="{Binding GadgetOpacity}" ToolTip="{h:Tr 'Transparência do fundo do gadget (10% = quase transparente)'}"/>

                    <TextBlock Text="{h:Tr '🚨  Cores dos alertas de temperatura'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding AlertOptions}" ItemTemplate="{StaticResource ColorRow}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{h:Tr '🖥️  Janela principal (maximizada)'}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding MainOptions}" ItemTemplate="{StaticResource ColorRow}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{h:Tr 'Deixe o campo vazio para usar a cor padrão do tema.'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>


        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
