<UserControl x:Class="StatsMonitor.Views.AppearanceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:StatsMonitor.Helpers"
        FontFamily="Segoe UI">
    <UserControl.Resources>
        <DataTemplate x:Key="ColorRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                <TextBox Grid.Column="1" Width="100" HorizontalAlignment="Left" h:Hint.Text="{Binding DefaultHex, Mode=OneWay}" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Hexadecimal (#RRGGBB ou #AARRGGBB). Vazio = padrão do tema"/>
                <ToggleButton x:Name="Toggle" Grid.Column="2" Width="40" Height="22" Cursor="Hand" ToolTip="Abrir seletor RGB"
                              IsChecked="{Binding IsOpen, ElementName=Pop, Mode=TwoWay}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="4" Background="{Binding Preview}"
                                                BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen, ElementName=Pop}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Left" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="6">
                        <StackPanel Width="230">
                            <Border Height="28" CornerRadius="4" Background="{Binding Preview}" Margin="0,0,0,8"/>
                            <DockPanel><TextBlock Text="R" Width="18" Foreground="#FF5555"/><TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding R, StringFormat={}{0:0}}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding R}"/></DockPanel>
                            <DockPanel><TextBlock Text="G" Width="18" Foreground="#55DD55"/><TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding G, StringFormat={}{0:0}}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding G}"/></DockPanel>
                            <DockPanel><TextBlock Text="B" Width="18" Foreground="#5599FF"/><TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" Text="{Binding B, StringFormat={}{0:0}}"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding B}"/></DockPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Margin="16,20,0,20" Padding="14" VerticalAlignment="Top" CornerRadius="12" Width="180" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="AÇÕES" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <Button Content="💾  Salvar" ToolTip="Aplica, salva e volta à tela principal" Style="{StaticResource PillButton}" Background="{DynamicResource Accent}" Foreground="White" FontWeight="SemiBold" Command="{Binding SaveCommand}" Margin="0,0,0,8"/>
            <Button Content="✔  Aplicar" ToolTip="Aplica e salva as alterações sem sair desta tela" Style="{StaticResource PillButton}" Command="{Binding ApplyCommand}" Margin="0,0,0,8"/>
            <Button Content="✖  Cancelar" ToolTip="Desfaz o que não foi aplicado ou salvo e volta" Style="{StaticResource PillButton}" Click="OnCancel" Margin="0,0,0,8"/>
            <Rectangle Height="1" Fill="{DynamicResource CardBorder}" Margin="0,4,0,12"/>
            <Button Content="↺  Restaurar padrões" ToolTip="Limpa todas as cores e volta ao padrão do tema" Style="{StaticResource PillButton}" Command="{Binding ResetCommand}"/>
        </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Minhas personalizações" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,0">
                <Button DockPanel.Dock="Right" Content="Excluir" ToolTip="Exclui a personalização com o nome do campo" Style="{StaticResource PillButton}" Command="{Binding DeletePresetCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Carregar" ToolTip="Carrega como prévia a personalização com o nome do campo" Style="{StaticResource PillButton}" Command="{Binding LoadPresetCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Salvar como" ToolTip="Salva as cores atuais com o nome do campo (substitui se o nome já existir)" Style="{StaticResource PillButton}" Command="{Binding SavePresetCommand}" Margin="8,0,0,0"/>
                <Grid>
                    <TextBox x:Name="PresetBox" TextChanged="OnPresetTextChanged" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Padding="4,5,28,5" h:Hint.Text="Digite um nome ou escolha uma personalização salva" ToolTip="Nome da personalização: digite para criar ou clique na seta para escolher uma salva"/>
                    <ToggleButton x:Name="PresetToggle" HorizontalAlignment="Right" Width="26" Content="▾" Cursor="Hand" Background="Transparent"
                                  Foreground="{DynamicResource TextSecondary}" BorderThickness="0" ToolTip="Mostrar personalizações salvas"
                                  IsChecked="{Binding IsOpen, ElementName=PresetPopup, Mode=TwoWay}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=PresetPopup}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,2,6,6" MinWidth="260" MaxHeight="220">
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" SelectionChanged="OnPresetPicked"
                                     Background="Transparent" BorderThickness="0" DisplayMemberPath="Name" Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>            <TextBlock Text="Escolher ou carregar mostra a prévia; use Aplicar ou Salvar para manter. Os presets criados ou excluídos são mantidos mesmo ao cancelar." Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tema base" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Content="Escuro" ToolTip="Usa as cores escuras como base" IsChecked="{Binding DarkTheme}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0"/>
                        <RadioButton GroupName="Theme" Content="Claro" ToolTip="Usa as cores claras como base" IsChecked="{Binding LightTheme}" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <TextBlock Text="Gadget (minimizado)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding GadgetOptions}" ItemTemplate="{StaticResource ColorRow}"/>
                    <TextBlock Text="{Binding GadgetOpacity, StringFormat=Opacidade do fundo: {0}%}" Margin="0,6,0,0"/>
                    <Slider Minimum="10" Maximum="100" Value="{Binding GadgetOpacity}" ToolTip="Transparência do fundo do gadget (10% = quase transparente)"/>

                    <TextBlock Text="Cores dos alertas de temperatura" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding AlertOptions}" ItemTemplate="{StaticResource ColorRow}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Janela principal (maximizada)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding MainOptions}" ItemTemplate="{StaticResource ColorRow}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Deixe o campo vazio para usar a cor padrão do tema." Style="{StaticResource Caption}" Margin="0,12,0,0"/>


        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
