<Window x:Class="StatsMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="90"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Geral" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Intervalo de atualização (s):" VerticalAlignment="Center" Width="200"/>
            <TextBox Style="{StaticResource Field}" Text="{Binding IntervalSeconds, StringFormat=0.##}"/>
        </StackPanel>
        <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding RunAtStartup}"/>
        <CheckBox Content="Iniciar minimizado" IsChecked="{Binding StartMinimized}"/>
        <CheckBox Content="Exibir temperaturas" IsChecked="{Binding ShowTemperatures}"/>
        <CheckBox Content="Exibir gadget" IsChecked="{Binding ShowGadget}"/>
        <CheckBox Content="Manter gadget sempre visível" IsChecked="{Binding AlwaysShowGadget}"/>
        <TextBlock Text="Exibição do gadget ao minimizar" Style="{StaticResource Caption}" Margin="0,8,0,2"/>
        <RadioButton GroupName="GadgetMode" Content="Sobre a tela (flutuante, arrastável)" IsChecked="{Binding GadgetFloating}" Foreground="{DynamicResource TextPrimary}" Margin="0,2"/>
        <RadioButton GroupName="GadgetMode" Content="Na barra de tarefas, canto direito (widget)" IsChecked="{Binding GadgetOnTaskbar}" Foreground="{DynamicResource TextPrimary}" Margin="0,2"/>

        <TextBlock Text="Painéis exibidos" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Janela principal" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                <CheckBox Content="CPU" IsChecked="{Binding ShowCpuMain}"/>
                <CheckBox Content="GPU" IsChecked="{Binding ShowGpuMain}"/>
                <CheckBox Content="Memória RAM" IsChecked="{Binding ShowRamMain}"/>
                <CheckBox Content="Memória VRAM" IsChecked="{Binding ShowVramMain}"/>
                <CheckBox Content="Rede / Internet" IsChecked="{Binding ShowNetworkMain}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Gadget (minimizado)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                <CheckBox Content="CPU" IsChecked="{Binding ShowCpuGadget}"/>
                <CheckBox Content="GPU" IsChecked="{Binding ShowGpuGadget}"/>
                <CheckBox Content="Memória RAM" IsChecked="{Binding ShowRamGadget}"/>
                <CheckBox Content="Memória VRAM" IsChecked="{Binding ShowVramGadget}"/>
                <CheckBox Content="Rede / Internet" IsChecked="{Binding ShowNetworkGadget}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Alertas de temperatura (°C)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1" Text="Atenção" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="2" Text="Crítica" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Row="1" Text="CPU" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Margin="0,3" Text="{Binding CpuWarnTemp}"/>
            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" Margin="0,3" Text="{Binding CpuCritTemp}"/>
            <TextBlock Grid.Row="2" Text="GPU" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Margin="0,3" Text="{Binding GpuWarnTemp}"/>
            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Field}" Margin="0,3" Text="{Binding GpuCritTemp}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource PillButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Aplicar" Style="{StaticResource PillButton}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
            <Button Content="Salvar" Style="{StaticResource PillButton}" IsDefault="True" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
