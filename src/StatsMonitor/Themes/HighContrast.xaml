<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="CardBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="CardBorder" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TrackBrush" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="InputBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HotTrackColor}"/>
    <SolidColorBrush x:Key="Accent2" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ControlBorder" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="ControlBorderHover" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="GadgetBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="GadgetText" Color="{x:Static SystemColors.WindowTextColor}"/>
</ResourceDictionary>
