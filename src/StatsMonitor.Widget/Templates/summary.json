{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "ColumnSet", "columns": [
      { "type": "Column", "width": "stretch", "items": [
        { "type": "TextBlock", "text": "CPU", "isSubtle": true, "size": "Small" },
        { "type": "TextBlock", "text": "${cpu}", "weight": "Bolder", "size": "Large" },
        { "type": "TextBlock", "text": "${cpuTemp}", "isSubtle": true, "size": "Small", "spacing": "None" } ] },
      { "type": "Column", "width": "stretch", "items": [
        { "type": "TextBlock", "text": "RAM", "isSubtle": true, "size": "Small" },
        { "type": "TextBlock", "text": "${ram}", "weight": "Bolder", "size": "Large" },
        { "type": "TextBlock", "text": "${ramUsed}", "isSubtle": true, "size": "Small", "spacing": "None" } ] } ] },
    { "type": "ColumnSet", "columns": [
      { "type": "Column", "width": "stretch", "items": [
        { "type": "TextBlock", "text": "GPU", "isSubtle": true, "size": "Small" },
        { "type": "TextBlock", "text": "${gpu}", "weight": "Bolder", "size": "Large" },
        { "type": "TextBlock", "text": "${gpuTemp}", "isSubtle": true, "size": "Small", "spacing": "None" } ] },
      { "type": "Column", "width": "stretch", "items": [
        { "type": "TextBlock", "text": "Disco", "isSubtle": true, "size": "Small" },
        { "type": "TextBlock", "text": "${disk}", "weight": "Bolder", "size": "Large" },
        { "type": "TextBlock", "text": "${status}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true } ] } ] }
  ]
}